<section class="tab skills" data-group="primary" data-tab="skills">
  <h2>{{localize "VSD.Skills.Title"}}</h2>
  <div class="skills-list">
    {{#each categories as |category|}}
    {{#if (lookup ../skillsByCategory category)}}
    <div class="skill-category">
      <h3>{{localize (concat "VSD.Skills.Categories." category)}}</h3>
      <table class="skills-table">
        <thead>
          <tr>
            <th class="skill-name">{{localize "VSD.Skills.Name"}}</th>
            <th class="skill-rank">{{localize "VSD.Skills.Rank"}}</th>
            <th class="skill-rank-bonus">{{localize "VSD.Skills.RankBonus"}}</th>
            <th class="skill-stat-bonus">{{localize "VSD.Skills.StatBonus"}}</th>
            <th class="skill-total">{{localize "VSD.Skills.Total"}}</th>
            <th class="skill-roll">{{localize "VSD.Skills.Roll"}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each (lookup ../skillsByCategory category) as |skill|}}
          <tr class="skill-row" data-skill="{{skill.name}}">
            <td class="skill-name">
              <span class="skill-label" title="{{skill.statKey}}">{{skill.name}}</span>
            </td>
            <td class="skill-rank">
              <input type="number" name="system.skills.{{@index}}.rank" value="{{skill.rank}}" min="0" max="30"
                class="skill-rank-input" />
            </td>
            <td class="skill-rank-bonus">{{skill.rankBonus}}</td>
            <td class="skill-stat-bonus">{{skill.statBonus}}</td>
            <td class="skill-total">{{skill.totalBonus}}</td>
            <td class="skill-roll">
              <button type="button" class="roll-skill-btn" data-action="rollSkill" data-skill-name="{{skill.name}}"
                data-skill-bonus="{{skill.totalBonus}}" data-stat-key="{{skill.statKey}}" data-category="{{category}}"
                title="{{localize " VSD.Skills.RollTooltip"}}">
                {{localize "VSD.Skills.RollButton"}}
              </button>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{/if}}
    {{/each}}
  </div>
</section>