<section class="tab biography" data-group="primary" data-tab="biography">

  <div class="biography-container">

    {{!-- Character Building Items (Kin, Culture, Vocation) --}}
    <div class="biography-items-grid">
      <div class="biography-item-slot">
        <h4>{{localize "VSD.Biography.Kin"}}</h4>
        {{#if kinItem}}
        <div class="item-slot-content">
          <span class="item-name">{{kinItem.name}}</span>
          <button type="button" class="remove-item-btn" data-action="removeItem" data-item-type="kin" title="Remove">&#x00d7;</button>
        </div>
        {{else}}
        <div class="item-slot-empty">
          <span class="placeholder">{{localize "VSD.Biography.DragItemHere"}}</span>
        </div>
        {{/if}}
      </div>

      <div class="biography-item-slot">
        <h4>{{localize "VSD.Biography.Culture"}}</h4>
        {{#if cultureItem}}
        <div class="item-slot-content">
          <span class="item-name">{{cultureItem.name}}</span>
          <button type="button" class="remove-item-btn" data-action="removeItem" data-item-type="culture" title="Remove">&#x00d7;</button>
        </div>
        {{else}}
        <div class="item-slot-empty">
          <span class="placeholder">{{localize "VSD.Biography.DragItemHere"}}</span>
        </div>
        {{/if}}
      </div>

      <div class="biography-item-slot">
        <h4>{{localize "VSD.Biography.Vocation"}}</h4>
        {{#if vocationItem}}
        <div class="item-slot-content">
          <span class="item-name">{{vocationItem.name}}</span>
          <button type="button" class="remove-item-btn" data-action="removeItem" data-item-type="vocation" title="Remove">&#x00d7;</button>
        </div>
        {{else}}
        <div class="item-slot-empty">
          <span class="placeholder">{{localize "VSD.Biography.DragItemHere"}}</span>
        </div>
        {{/if}}
      </div>
    </div>

    {{!-- Biography Text --}}
    <div class="biography-section">
      <h3>{{localize "VSD.Biography.BiographyText"}}</h3>
      <textarea name="system.biography" class="biography-textarea" placeholder="Enter character biography...">{{biography}}</textarea>
    </div>

    {{!-- Appearance --}}
    <div class="biography-section">
      <h3>{{localize "VSD.Biography.Appearance"}}</h3>
      <textarea name="system.appearance" class="appearance-textarea" placeholder="Enter character appearance...">{{appearance}}</textarea>
    </div>

    {{!-- Background Notes --}}
    <div class="biography-section">
      <h3>{{localize "VSD.Biography.BackgroundNotes"}}</h3>
      <textarea name="system.backgroundNotes" class="background-notes-textarea" placeholder="Enter background notes...">{{backgroundNotes}}</textarea>
    </div>

  </div>

</section>
