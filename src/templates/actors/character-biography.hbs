<section class="tab biography {{tab.cssClass}} open00-tab-scroll" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <div class="biography-identity-grid">
    <section class="sheet-section identity-card" data-item-id="{{identity.kin.id}}">
      <h2 class="section-title">{{localize "OPEN00.Biography.Kin"}}</h2>
      {{#if identity.kin}}
      <button type="button" class="item-name-button" data-action="openItem" data-item-id="{{identity.kin.id}}">{{identity.kin.name}}</button>
      <button type="button" class="icon-button danger" data-action="removeItem" data-item-id="{{identity.kin.id}}" title="{{localize 'OPEN00.Actions.Remove'}}"><i class="fas fa-trash" aria-hidden="true"></i></button>
      {{else}}<p class="empty-state compact">{{localize "OPEN00.Biography.DragItemHere"}}</p>{{/if}}
    </section>
    <section class="sheet-section identity-card" data-item-id="{{identity.culture.id}}">
      <h2 class="section-title">{{localize "OPEN00.Biography.Culture"}}</h2>
      {{#if identity.culture}}
      <button type="button" class="item-name-button" data-action="openItem" data-item-id="{{identity.culture.id}}">{{identity.culture.name}}</button>
      <button type="button" class="icon-button danger" data-action="removeItem" data-item-id="{{identity.culture.id}}" title="{{localize 'OPEN00.Actions.Remove'}}"><i class="fas fa-trash" aria-hidden="true"></i></button>
      {{else}}<p class="empty-state compact">{{localize "OPEN00.Biography.DragItemHere"}}</p>{{/if}}
    </section>
    <section class="sheet-section identity-card" data-item-id="{{identity.vocation.id}}">
      <h2 class="section-title">{{localize "OPEN00.Biography.Vocation"}}</h2>
      {{#if identity.vocation}}
      <button type="button" class="item-name-button" data-action="openItem" data-item-id="{{identity.vocation.id}}">{{identity.vocation.name}}</button>
      <button type="button" class="icon-button danger" data-action="removeItem" data-item-id="{{identity.vocation.id}}" title="{{localize 'OPEN00.Actions.Remove'}}"><i class="fas fa-trash" aria-hidden="true"></i></button>
      {{else}}<p class="empty-state compact">{{localize "OPEN00.Biography.DragItemHere"}}</p>{{/if}}
    </section>
  </div>

  <div class="biography-details-grid">
    <section class="sheet-section collection-section">
      <h2 class="section-title">{{localize "OPEN00.Biography.SpecialAbilities"}}</h2>
      {{#each traits}}
      <div class="collection-row" data-item-id="{{id}}"><button type="button" class="item-name-button with-image" data-action="openItem" data-item-id="{{id}}"><img src="{{img}}" alt="" />{{name}}</button><button type="button" class="icon-button danger" data-action="removeItem" data-item-id="{{id}}" title="{{localize 'OPEN00.Actions.Remove'}}"><i class="fas fa-trash" aria-hidden="true"></i></button></div>
      {{else}}<p class="empty-state compact">{{localize "OPEN00.Biography.NoSpecialAbilities"}}</p>{{/each}}
    </section>
    <section class="sheet-section collection-section">
      <h2 class="section-title">{{localize "OPEN00.Biography.BackgroundOptions"}}</h2>
      {{#each backgrounds}}
      <div class="collection-row" data-item-id="{{id}}"><button type="button" class="item-name-button with-image" data-action="openItem" data-item-id="{{id}}"><img src="{{img}}" alt="" />{{name}}</button><button type="button" class="icon-button danger" data-action="removeItem" data-item-id="{{id}}" title="{{localize 'OPEN00.Actions.Remove'}}"><i class="fas fa-trash" aria-hidden="true"></i></button></div>
      {{else}}<p class="empty-state compact">{{localize "OPEN00.Biography.NoBackgroundOptions"}}</p>{{/each}}
    </section>
  </div>

  <div class="biography-text-grid">
    <div class="sheet-section text-section">
      <span class="section-title">{{localize "OPEN00.Biography.BiographyText"}}</span>
      {{#if editable}}
      <prose-mirror name="system.biography" value="{{source.biography}}"></prose-mirror>
      {{else}}
      <div class="editor"><div class="editor-content">{{{enrichedBiography}}}</div></div>
      {{/if}}
    </div>
    <div class="sheet-section text-section">
      <span class="section-title">{{localize "OPEN00.Biography.Appearance"}}</span>
      {{#if editable}}
      <prose-mirror name="system.appearance" value="{{source.appearance}}"></prose-mirror>
      {{else}}
      <div class="editor"><div class="editor-content">{{{enrichedAppearance}}}</div></div>
      {{/if}}
    </div>
    <div class="sheet-section text-section full-width">
      <span class="section-title">{{localize "OPEN00.Biography.BackgroundNotes"}}</span>
      {{#if editable}}
      <prose-mirror name="system.backgroundNotes" value="{{source.backgroundNotes}}"></prose-mirror>
      {{else}}
      <div class="editor"><div class="editor-content">{{{enrichedBackgroundNotes}}}</div></div>
      {{/if}}
    </div>
  </div>
</section>
