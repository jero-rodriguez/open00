<section class="tab magic" data-group="primary" data-tab="magic">

  <div class="magic-grid-section">
    {{!-- Magic Points --}}
    <div class="block">
      <h3>{{localize "VSD.Magic.MagicPoints"}}</h3>
      <div class="magicpoint-grid-section">
        <div>
          <span class="large-roundborder">
            <input type="number" class="current-hit-points hitpoint-color" name="system.mp.value" value="{{mp.value}}" min="0" />
          </span>
          <div class="roundborder-label">{{localize "VSD.Overview.Current"}}</div>
        </div>
        <div class="tablelike">
          <div class="rowlike">
            <div class="celllike">
              <label class="field-label">{{localize "VSD.Overview.Max"}}</label>
            </div>
            <div class="celllike">
              <input type="number" class="stat-input total" name="system.mp.max" value="{{mp.max}}" />
            </div>
          </div>
        </div>
      </div>
    </div>

    {{!-- Spell Lores --}}
    <div class="block">
      <h3>{{localize "VSD.Magic.Spells"}}</h3>
      {{#if spellsByLore}}
      <div class="spelllore-grid-table table-header">
        <div class="skills-cell">{{localize "VSD.Magic.LoreName"}}</div>
        <div class="skills-cell">{{localize "VSD.Magic.CastingBonus"}}</div>
        <div class="skills-cell">{{localize "VSD.Magic.SpellCount"}}</div>
      </div>
      {{#each spellsByLore as |lore|}}
      <div class="spelllore-grid-table">
        <div class="skills-cell skills-name-cell">
          <span class="skill-name">{{lore.loreName}}</span>
        </div>
        <div class="skills-cell">
          <span class="casting-bonus-value">+{{lore.castingBonus}}</span>
        </div>
        <div class="skills-cell">
          <span>{{lore.spells.length}}</span>
        </div>
      </div>

      {{!-- Spells in this lore --}}
      {{#each lore.spells as |spell|}}
      <div class="spell-entry">
        <div class="spell-header">
          <span class="spell-name">{{spell.name}}</span>
          <span class="spell-weave">{{localize "VSD.Magic.Weave"}} {{spell.weaveNumber}}</span>
          <span class="spell-mp-cost">(MP: {{spell.mpCost}})</span>
        </div>
        <div class="spell-details">
          {{#if spell.range}}<span class="spell-detail">{{localize "VSD.Magic.Range"}}: {{spell.range}}</span>{{/if}}
          {{#if spell.duration}}<span class="spell-detail">{{localize "VSD.Magic.Duration"}}: {{spell.duration}}</span>{{/if}}
          {{#if spell.areaOfEffect}}<span class="spell-detail">{{localize "VSD.Magic.AreaOfEffect"}}: {{spell.areaOfEffect}}</span>{{/if}}
        </div>
      </div>
      {{/each}}
      {{/each}}
      {{else}}
      <div class="empty-state">{{localize "VSD.Magic.NoSpells"}}</div>
      {{/if}}
    </div>
  </div>

</section>
