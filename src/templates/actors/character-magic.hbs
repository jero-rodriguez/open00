<section class="tab magic {{tab.cssClass}} open00-tab-scroll" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <div class="magic-layout">
    <aside class="sheet-section magic-points-card">
      <h2 class="section-title">{{localize "OPEN00.Magic.MagicPoints"}}</h2>
      <label class="resource-orb magic-orb">
        <input type="number" name="system.mp.value" value="{{mp.value}}" min="0" />
        <span>{{localize "OPEN00.Overview.Current"}}</span>
      </label>
      <label class="compact-rule-field"><span>{{localize "OPEN00.Overview.Max"}}</span><span class="computed-cell">{{mpMax}}</span></label>
      <p class="magic-level-info">{{localize "OPEN00.Magic.Level"}}: {{level}}</p>
    </aside>

    <main class="sheet-section spellbook">
      <h2 class="section-title">{{localize "OPEN00.Magic.SpellLores"}}</h2>
      {{#each spellLores}}
      <section class="spell-lore" data-item-id="{{id}}">
        <header class="spell-lore-header">
          <button type="button" class="item-name-button lore-name" data-action="openItem" data-item-id="{{id}}">
            <h3>{{name}}</h3>
          </button>
          <span class="lore-category lore-category--{{category}}">{{category}}</span>
          <span class="lore-ranks" title="{{localize "OPEN00.Magic.Ranks"}}">{{ranks}}</span>
          <strong class="lore-bonus" title="{{localize "OPEN00.Magic.CastingBonus"}}">{{castingBonus}}</strong>
          <span class="lore-max-weave" title="{{localize "OPEN00.Magic.MaxWeave"}}">{{localize "OPEN00.Magic.MaxWeaveShort"}} {{maxCastableWeave}}</span>
          <span class="row-actions">
            <button type="button" class="icon-button danger" data-action="removeItem" data-item-id="{{id}}" title="{{localize 'OPEN00.Actions.Remove'}}"><i class="fas fa-trash" aria-hidden="true"></i></button>
          </span>
        </header>

        {{#if spells.length}}
        <div class="spell-table spell-heading">
          <span>{{localize "OPEN00.Magic.SpellName"}}</span>
          <span>{{localize "OPEN00.Magic.Weave"}}</span>
          <span>{{localize "OPEN00.Magic.MPCost"}}</span>
          <span>{{localize "OPEN00.Magic.Range"}}</span>
          <span>{{localize "OPEN00.Magic.Duration"}}</span>
          <span>{{localize "OPEN00.Magic.AreaOfEffect"}}</span>
          <span>{{localize "OPEN00.Magic.SaveRoll"}}</span>
        </div>
        {{#each spells}}
        <div class="spell-table item-row {{unless canCast 'spell-row--locked'}}">
          <span class="spell-name">{{name}}{{#if isInstantaneous}}*{{/if}}</span>
          <span>{{weave}}</span>
          <span>{{mpCost}}</span>
          <span>{{range}}</span>
          <span>{{duration}}</span>
          <span>{{areaOfEffect}}</span>
          <span>{{#if grantsSaveRoll}}{{localize "OPEN00.Common.Yes"}}{{else}}{{localize "OPEN00.Common.No"}}{{/if}}</span>
        </div>
        {{/each}}
        {{else}}
        <p class="empty-state">{{localize "OPEN00.Magic.NoSpellsInLore"}}</p>
        {{/if}}
      </section>
      {{else}}
      <p class="empty-state">{{localize "OPEN00.Magic.NoSpellLores"}}</p>
      {{/each}}
    </main>
  </div>
</section>
