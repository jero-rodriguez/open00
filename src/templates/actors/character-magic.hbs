<section class="tab magic {{tab.cssClass}} open00-tab-scroll" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <div class="magic-layout">
    <aside class="sheet-section magic-points-card">
      <h2 class="section-title">{{localize "OPEN00.Magic.MagicPoints"}}</h2>
      <label class="resource-orb magic-orb">
        <input type="number" name="system.mp.value" value="{{mp.value}}" min="0" />
        <span>{{localize "OPEN00.Overview.Current"}}</span>
      </label>
      <label class="compact-rule-field"><span>{{localize "OPEN00.Overview.Max"}}</span><input type="number" name="system.mp.max" value="{{mp.max}}" min="0" /></label>
    </aside>

    <main class="sheet-section spellbook">
      <h2 class="section-title">{{localize "OPEN00.Magic.Spells"}}</h2>
      <div class="spell-lore-heading">
        <span>{{localize "OPEN00.Magic.LoreName"}}</span>
        <span>{{localize "OPEN00.Magic.CastingBonus"}}</span>
        <span>{{localize "OPEN00.Magic.SpellCount"}}</span>
      </div>
      {{#each spellsByLore}}
      <section class="spell-lore">
        <header>
          <h3>{{loreName}}</h3>
          <strong>{{castingBonus}}</strong>
          <span>{{spells.length}}</span>
        </header>
        <div class="spell-table spell-heading">
          <span>{{localize "OPEN00.Magic.SpellName"}}</span><span>{{localize "OPEN00.Magic.Weave"}}</span>
          <span>{{localize "OPEN00.Magic.MPCost"}}</span><span>{{localize "OPEN00.Magic.Range"}}</span>
          <span>{{localize "OPEN00.Magic.Duration"}}</span><span>{{localize "OPEN00.Magic.AreaOfEffect"}}</span>
          <span>{{localize "OPEN00.Magic.SaveRoll"}}</span><span></span>
        </div>
        {{#each spells}}
        <div class="spell-table item-row" data-item-id="{{id}}">
          <button type="button" class="item-name-button" data-action="openItem" data-item-id="{{id}}">{{name}}</button>
          <span>{{weaveNumber}}</span><span>{{mpCost}}</span><span>{{range}}</span><span>{{duration}}</span>
          <span>{{areaOfEffect}}</span><span>{{#if grantsSaveRoll}}{{localize "OPEN00.Common.Yes"}}{{else}}{{localize "OPEN00.Common.No"}}{{/if}}</span>
          <span class="row-actions"><button type="button" class="icon-button danger" data-action="removeItem" data-item-id="{{id}}" title="{{localize 'OPEN00.Actions.Remove'}}"><i class="fas fa-trash" aria-hidden="true"></i></button></span>
        </div>
        {{/each}}
      </section>
      {{else}}
      <p class="empty-state">{{localize "OPEN00.Magic.NoSpells"}}</p>
      {{/each}}
    </main>
  </div>
</section>
