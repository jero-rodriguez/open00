<section class="tab magic" data-group="primary" data-tab="magic">
  <h2>{{localize "VSD.Magic.Title"}}</h2>

  {{!-- Magic Points Block --}}
  <div class="magic-vitals">
    <div class="vital-block">
      <h3>{{localize "VSD.Overview.MagicPoints"}}</h3>
      <div class="vitals-display">
        <div class="vital-pair">
          <input type="number" name="system.mp.value" value="{{mp.value}}" class="vital-current" />
          <span class="vital-label">{{localize "VSD.Overview.Current"}}</span>
        </div>
        <span class="separator">/</span>
        <div class="vital-pair">
          <input type="number" name="system.mp.max" value="{{mp.max}}" class="vital-max" />
          <span class="vital-label">{{localize "VSD.Overview.Max"}}</span>
        </div>
      </div>
    </div>
  </div>

  {{!-- Spells organized by Spell Lore --}}
  <div class="magic-section spells-section">
    <h3>{{localize "VSD.Magic.Spells"}}</h3>
    {{#if spellsByLore}}
      <div class="spells-by-lore">
        {{#each spellsByLore as |spellLore|}}
          <div class="spell-lore-group">
            <h4 class="spell-lore-name">{{spellLore.loreName}}</h4>
            {{#if spellLore.castingBonus}}
              <div class="spell-lore-bonus">
                <span class="casting-bonus-label">{{localize "VSD.Magic.CastingBonus"}}:</span>
                <span class="casting-bonus-value">+{{spellLore.castingBonus}}</span>
              </div>
            {{/if}}
            {{#if spellLore.spells}}
              <div class="spells-list">
                {{#each spellLore.spells as |spell|}}
                  <div class="spell-entry">
                    <div class="spell-header">
                      <h5 class="spell-name">{{spell.name}}</h5>
                      <span class="spell-weave">{{localize "VSD.Magic.Weave"}} {{spell.weaveNumber}}</span>
                      <span class="spell-mp-cost">({{localize "VSD.Magic.MPCost"}}: {{spell.mpCost}})</span>
                    </div>
                    <div class="spell-details">
                      {{#if spell.range}}
                        <div class="detail-row">
                          <span class="detail-label">{{localize "VSD.Magic.Range"}}:</span>
                          <span class="detail-value">{{spell.range}}</span>
                        </div>
                      {{/if}}
                      {{#if spell.duration}}
                        <div class="detail-row">
                          <span class="detail-label">{{localize "VSD.Magic.Duration"}}:</span>
                          <span class="detail-value">{{spell.duration}}</span>
                        </div>
                      {{/if}}
                      {{#if spell.areaOfEffect}}
                        <div class="detail-row">
                          <span class="detail-label">{{localize "VSD.Magic.AreaOfEffect"}}:</span>
                          <span class="detail-value">{{spell.areaOfEffect}}</span>
                        </div>
                      {{/if}}
                      {{#if spell.grantsSaveRoll}}
                        <div class="detail-row">
                          <span class="detail-label">{{localize "VSD.Magic.SaveRoll"}}:</span>
                          <span class="detail-value">{{localize "VSD.Magic.Yes"}}</span>
                        </div>
                      {{/if}}
                    </div>
                  </div>
                {{/each}}
              </div>
            {{else}}
              <div class="empty-state-small">{{localize "VSD.Magic.NoSpellsInLore"}}</div>
            {{/if}}
          </div>
        {{/each}}
      </div>
    {{else}}
      <div class="empty-state">{{localize "VSD.Magic.NoSpells"}}</div>
    {{/if}}
  </div>

</section>
