<section class="tab equipment {{ tab.cssClass }}" data-group="{{ tab.group }}" data-tab="{{ tab.id }}">

  <div class="equipment-grid-section">
    {{!-- Equipment, Gear & Vehicles --}}
    <div class="block">
      <h3>{{localize "VSD.Equipment.CarriedItems"}}</h3>
      {{#if items}}
      <div class="gear-grid-section table-header">
        <div>{{localize "VSD.Equipment.ItemName"}}</div>
        <div>{{localize "VSD.Equipment.Quantity"}}</div>
        <div>{{localize "VSD.Equipment.Weight"}}</div>
        <div>{{localize "VSD.Equipment.Encumbrance"}}</div>
        <div></div>
      </div>
      {{#each items as |item|}}
      <div class="gear-grid-section" data-item-id="{{item.id}}">
        <div class="item-link">{{item.name}}</div>
        <div>{{item.quantity}}</div>
        <div>{{item.weight}}</div>
        <div>{{item.encumbrance}}</div>
        <div>
          <button type="button" class="remove-item-btn" data-action="removeItem" data-item-id="{{item.id}}" title="Remove">&#x00d7;</button>
        </div>
      </div>
      {{/each}}

      {{!-- Encumbrance Summary --}}
      <div class="encumbrance-info">
        <div class="tablelike">
          <div class="rowlike">
            <div class="celllike">
              <label class="field-label">{{localize "VSD.Equipment.TotalEncumbrance"}}:</label>
            </div>
            <div class="celllike">
              <span class="total">{{totalEncumbrancePoints}}</span>
            </div>
          </div>
          <div class="rowlike">
            <div class="celllike">
              <label class="field-label">{{localize "VSD.Equipment.EncumbranceLevel"}}:</label>
            </div>
            <div class="celllike">
              <span>{{encumbrance}}</span>
            </div>
          </div>
        </div>
      </div>
      {{else}}
      <div class="empty-state">{{localize "VSD.Equipment.NoItems"}}</div>
      {{/if}}
    </div>

    {{!-- Wealth Level & Status --}}
    <div class="block">
      <h3>{{localize "VSD.Equipment.WealthLevel"}}</h3>
      <div class="wealthstatus-grid-section">
        <input type="number" name="system.wealth" value="{{wealth}}" min="0" max="5" class="wealth-input" />
        <span class="wealth-label">(0-5)</span>
      </div>
    </div>
  </div>

  {{!-- Items of Power --}}
  <div class="block">
    <h3>{{localize "VSD.Equipment.ItemsOfPower"}}</h3>
    {{#if itemsOfPower}}
    <div class="items-of-power-list">
      {{#each itemsOfPower as |iop|}}
      <div class="item-of-power-entry">
        <div class="iop-header">
          <strong class="iop-name">{{iop.name}}</strong>
          <span class="iop-affinity">{{localize "VSD.Equipment.AffinityLevel"}}: {{iop.affinityLevel}}/5</span>
          {{#if iop.isAttuned}}
          <span class="attuned-badge">{{localize "VSD.Equipment.Attuned"}}</span>
          {{/if}}
        </div>
        {{#if iop.activeBonuses}}
        <div class="iop-bonuses">
          {{#each iop.activeBonuses as |bonus|}}
          <div class="bonus-item">{{bonus.effect}} (Threshold: {{bonus.threshold}})</div>
          {{/each}}
        </div>
        {{/if}}
      </div>
      {{/each}}
    </div>
    {{else}}
    <div class="empty-state">{{localize "VSD.Equipment.NoItemsOfPower"}}</div>
    {{/if}}
  </div>

</section>
