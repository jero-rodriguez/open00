<section class="tab equipment {{tab.cssClass}} open00-tab-scroll" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <div class="equipment-layout">
    <main class="sheet-section equipment-list">
      <h2 class="section-title">{{localize "OPEN00.Equipment.CarriedItems"}}</h2>
      <div class="equipment-table item-rules-table table-heading">
        <span>{{localize "OPEN00.Equipment.ItemName"}}</span><span>{{localize "OPEN00.Equipment.Type"}}</span>
        <span>{{localize "OPEN00.Equipment.Quantity"}}</span><span>{{localize "OPEN00.Equipment.Fare"}}</span>
        <span>{{localize "OPEN00.Equipment.Availability"}}</span><span>{{localize "OPEN00.Equipment.Encumbrance"}}</span><span></span>
      </div>
      {{#each items}}
      <div class="equipment-table item-rules-table item-row" data-item-id="{{id}}">
        <button type="button" class="item-name-button with-image" data-action="openItem" data-item-id="{{id}}"><img src="{{img}}" alt="" />{{name}}</button>
        <span>{{type}}</span><span>{{quantity}}</span><span>{{fare}}</span><span>{{availability}}</span><span>{{encumbranceCategory}}</span>
        <span class="row-actions"><button type="button" class="icon-button danger" data-action="removeItem" data-item-id="{{id}}" title="{{localize 'OPEN00.Actions.Remove'}}"><i class="fas fa-trash" aria-hidden="true"></i></button></span>
      </div>
      {{else}}
      <p class="empty-state">{{localize "OPEN00.Equipment.NoItems"}}</p>
      {{/each}}
    </main>

    <aside class="equipment-summary">
      <section class="sheet-section">
        <h2 class="section-title">{{localize "OPEN00.Equipment.WealthLevel"}}</h2>
        <label class="wealth-field">
          <input type="number" name="system.wealth" value="{{wealth}}" min="0" max="5" />
          <span>{{localize "OPEN00.Equipment.WealthScale"}}</span>
        </label>
      </section>

      <section class="sheet-section">
        <h2 class="section-title">{{localize "OPEN00.Overview.Encumbrance"}}</h2>
        <div class="encumbrance-summary">
          <strong>{{localize encumbranceLabel}}</strong>
          <span>{{totalEncumbrancePoints}} {{localize "OPEN00.Equipment.Points"}}</span>
        </div>
        <div class="encumbrance-meter" style="--encumbrance: {{encumbrancePercentage}}%;"><span></span></div>
      </section>
    </aside>
  </div>

  <section class="sheet-section power-items-section">
    <h2 class="section-title">{{localize "OPEN00.Equipment.ItemsOfPower"}}</h2>
    <div class="power-items-grid">
      {{#each itemsOfPower}}
      <article class="power-item" data-item-id="{{id}}">
        <header>
          <button type="button" class="item-name-button with-image" data-action="openItem" data-item-id="{{id}}"><img src="{{img}}" alt="" />{{name}}</button>
          <span>{{localize "OPEN00.Equipment.AffinityLevel"}} <strong>{{affinityLevel}}/10</strong></span>
          {{#if isAttuned}}<span class="status-badge">{{localize "OPEN00.Equipment.Attuned"}}</span>{{/if}}
        </header>
        {{#each activeBonuses}}
        <p><span class="threshold-mark">{{threshold}}</span>{{effect}}</p>
        {{else}}
        <p class="empty-state compact">{{localize "OPEN00.Equipment.NoActiveBonuses"}}</p>
        {{/each}}
      </article>
      {{else}}
      <p class="empty-state">{{localize "OPEN00.Equipment.NoItemsOfPower"}}</p>
      {{/each}}
    </div>
  </section>
</section>
