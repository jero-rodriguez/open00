<section class="tab combat {{tab.cssClass}} open00-tab-scroll" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <div class="status-grid">
    <section class="sheet-section status-card">
      <h2 class="section-title">{{localize "OPEN00.Combat.HitPoints"}}</h2>
      <div class="orb-and-fields">
        <label class="resource-orb">
          <input type="number" name="system.hp.value" value="{{hp.value}}" min="0" />
          <span>{{localize "OPEN00.Overview.Current"}}</span>
        </label>
        <label class="compact-rule-field"><span>{{localize "OPEN00.Combat.TotalHits"}}</span><input type="number" name="system.hp.max" value="{{hp.max}}" min="0" /></label>
      </div>
    </section>

    <section class="sheet-section status-card">
      <h2 class="section-title">{{localize "OPEN00.Combat.Movement"}}</h2>
      <div class="status-value">
        <span>{{localize "OPEN00.Overview.Encumbrance"}}</span>
        <strong>{{localize encumbranceLabel}}</strong>
      </div>
    </section>

    <section class="sheet-section status-card">
      <h2 class="section-title">{{localize "OPEN00.Overview.Defense"}}</h2>
      <label class="defense-field">
        <span>{{localize "OPEN00.Combat.MeleeDefense"}}</span>
        <input type="number" name="system.defense" value="{{defense}}" />
      </label>
    </section>
  </div>

  <section class="sheet-section">
    <h2 class="section-title">{{localize "OPEN00.Combat.Conditions"}}</h2>
    <div class="condition-strip">
      {{#each conditions}}
      <span>{{name}}{{#if duration}} ({{duration}}){{/if}}</span>
      {{else}}
      <span class="empty-state compact">{{localize "OPEN00.Combat.NoConditions"}}</span>
      {{/each}}
    </div>
  </section>

  <section class="sheet-section">
    <h2 class="section-title">{{localize "OPEN00.Header.DevelopmentPointsPerLevel"}}</h2>
    <div class="development-points-row">
      <div class="development-points-header">
        <span>{{localize "OPEN00.Header.DevelopmentPoints"}}</span>
        {{#each developmentPointsPerLevel}}
        <span class="development-point-value">{{this}}</span>
        {{else}}
        <span class="empty-state compact">{{localize "OPEN00.Combat.NoConditions"}}</span>
        {{/each}}
      </div>
    </div>
  </section>

  <section class="sheet-section item-table-section">
    <h2 class="section-title">{{localize "OPEN00.Combat.Armor"}}</h2>
    <div class="wide-table-scroll">
      <div class="armor-table item-rules-table table-heading">
        <span>{{localize "OPEN00.Combat.ArmorName"}}</span>
        <span>{{localize "OPEN00.Combat.ArmorType"}}</span>
        <span>{{localize "OPEN00.Combat.Zones"}}</span>
        <span>{{localize "OPEN00.Combat.MaxSwiftness"}}</span>
        <span>{{localize "OPEN00.Combat.MovePenalty"}}</span>
        <span>{{localize "OPEN00.Combat.CMBPenalty"}}</span>
        <span>{{localize "OPEN00.Combat.PerceptionPenalty"}}</span>
        <span>{{localize "OPEN00.Combat.MeleeDefenseShort"}}</span>
        <span>{{localize "OPEN00.Combat.MissileDefenseShort"}}</span>
        <span>{{localize "OPEN00.Combat.Qualities"}}</span>
        <span></span>
      </div>
      {{#each armor}}
      <div class="armor-table item-rules-table item-row" data-item-id="{{id}}">
        <button type="button" class="item-name-button" data-action="openItem" data-item-id="{{id}}">{{name}}</button>
        <span>{{armorType}}</span><span>{{zones}}</span><span>{{maxSwiToDefense}}</span>
        <span>{{moveActionsPenalty}}</span><span>{{cmbPenalty}}</span><span>{{perceptionPenalty}}</span>
        <span>{{meleeDefenseBonus}}</span><span>{{missileDefenseBonus}}</span><span>{{qualities}}</span>
        <span class="row-actions"><button type="button" class="icon-button danger" data-action="removeItem" data-item-id="{{id}}" title="{{localize 'OPEN00.Actions.Remove'}}"><i class="fas fa-trash" aria-hidden="true"></i></button></span>
      </div>
      {{else}}
      <p class="empty-state">{{localize "OPEN00.Combat.NoArmor"}}</p>
      {{/each}}
    </div>
  </section>

  <section class="sheet-section item-table-section">
    <h2 class="section-title">{{localize "OPEN00.Combat.Weapons"}}</h2>
    <div class="wide-table-scroll">
      <div class="weapons-table item-rules-table table-heading">
        <span>{{localize "OPEN00.Combat.WeaponName"}}</span><span>{{localize "OPEN00.Combat.Hands"}}</span>
        <span>{{localize "OPEN00.Combat.Length"}}</span><span>{{localize "OPEN00.Combat.SkillUsed"}}</span>
        <span>{{localize "OPEN00.Combat.ClumsyRange"}}</span><span>{{localize "OPEN00.Combat.AttackTable"}}</span>
        <span>{{localize "OPEN00.Combat.MaxResult"}}</span><span>{{localize "OPEN00.Combat.PrimaryCritical"}}</span>
        <span>{{localize "OPEN00.Combat.AlternateCritical"}}</span><span>{{localize "OPEN00.Combat.BaseRange"}}</span>
        <span>{{localize "OPEN00.Combat.Qualities"}}</span><span></span>
      </div>
      {{#each weapons}}
      <div class="weapons-table item-rules-table item-row" data-item-id="{{id}}">
        <button type="button" class="item-name-button" data-action="openItem" data-item-id="{{id}}">{{name}}</button>
        <span>{{hands}}</span><span>{{length}}</span><span>{{skillUsed}}</span><span>{{clumsyRange}}</span>
        <span>{{attackTable}}</span><span>{{maxResult}}</span><span>{{primaryCritical}}</span>
        <span>{{alternateCritical}}</span><span>{{baseRange}}</span><span>{{qualities}}</span>
        <span class="row-actions"><button type="button" class="icon-button danger" data-action="removeItem" data-item-id="{{id}}" title="{{localize 'OPEN00.Actions.Remove'}}"><i class="fas fa-trash" aria-hidden="true"></i></button></span>
      </div>
      {{else}}
      <p class="empty-state">{{localize "OPEN00.Combat.NoWeapons"}}</p>
      {{/each}}
    </div>
  </section>
</section>
