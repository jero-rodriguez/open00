<section class="tab combat" data-group="primary" data-tab="combat">

  <div class="movement-defense-grid-section">
    {{!-- Hit Points --}}
    <span class="block">
      <h3>{{localize "VSD.Combat.HitPoints"}}</h3>
      <div class="hitpoint-grid-section">
        <div>
          <span class="large-roundborder">
            <input type="number" class="current-hit-points hitpoint-color" name="system.hp.value" value="{{hp.value}}" min="0" />
          </span>
          <div class="roundborder-label">{{localize "VSD.Overview.Current"}}</div>
        </div>
        <div class="tablelike">
          <div class="rowlike">
            <div class="celllike">
              <label class="field-label">{{localize "VSD.Combat.TotalHits"}}</label>
            </div>
            <div class="celllike">
              <input type="number" class="stat-input total" name="system.hp.max" value="{{hp.max}}" />
            </div>
          </div>
        </div>
      </div>
    </span>

    {{!-- Defense --}}
    <div class="defense-block block">
      <h3>{{localize "VSD.Overview.Defense"}}</h3>
      <div class="tablelike">
        <div class="rowlike">
          <div class="celllike">
            <label class="field-label">{{localize "VSD.Combat.MeleeDefense"}}</label>
          </div>
          <div class="celllike">
            <input type="number" class="stat-input defense-color" name="system.defense" value="{{defense}}" />
          </div>
        </div>
      </div>
    </div>
  </div>

  {{!-- Conditions --}}
  <div class="block">
    <h3>{{localize "VSD.Combat.Conditions"}}</h3>
    <div class="conditions-grid-section">
      {{#each conditions as |condition|}}
      <span class="condition-name">{{condition.name}}</span>
      {{#if condition.duration}}
      <span class="condition-duration">({{condition.duration}})</span>
      {{/if}}
      {{/each}}
      {{#unless conditions}}
      <span class="empty-state-small">{{localize "VSD.Combat.NoConditions"}}</span>
      {{/unless}}
    </div>
  </div>

  {{!-- Armor & Shield --}}
  <span class="block">
    <h3>{{localize "VSD.Combat.Armor"}}</h3>
    {{#if armor}}
    <div class="armor-grid-section table-header">
      <div>{{localize "VSD.Combat.ArmorName"}}</div>
      <div>{{localize "VSD.Combat.ArmorType"}}</div>
      <div>{{localize "VSD.Combat.MeleeDefenseBonus"}}</div>
      <div>{{localize "VSD.Combat.MissileDefenseBonus"}}</div>
      <div>{{localize "VSD.Combat.CMBPenalty"}}</div>
      <div>{{localize "VSD.Combat.MoveActionsPenalty"}}</div>
    </div>
    {{#each armor as |armorItem|}}
    <div class="armor-grid-section">
      <div>{{armorItem.name}}</div>
      <div>{{armorItem.armorType}}</div>
      <div>{{armorItem.meleeDefenseBonus}}</div>
      <div>{{armorItem.missileDefenseBonus}}</div>
      <div>{{armorItem.cmbPenalty}}</div>
      <div>{{armorItem.moveActionsPenalty}}</div>
    </div>
    {{/each}}
    {{else}}
    <div class="empty-state">{{localize "VSD.Combat.NoArmor"}}</div>
    {{/if}}
  </span>

  {{!-- Weapons & Attacks --}}
  <span class="block">
    <h3>{{localize "VSD.Combat.Weapons"}}</h3>
    {{#if weapons}}
    <div class="weapons-grid-section table-header">
      <div>{{localize "VSD.Combat.WeaponName"}}</div>
      <div>{{localize "VSD.Combat.Hands"}}</div>
      <div>{{localize "VSD.Combat.Length"}}</div>
      <div>{{localize "VSD.Combat.SkillUsed"}}</div>
      <div>{{localize "VSD.Combat.AttackTable"}}</div>
      <div>{{localize "VSD.Combat.Critical"}}</div>
    </div>
    {{#each weapons as |weapon|}}
    <div class="weapons-grid-section">
      <div>{{weapon.name}}</div>
      <div>{{weapon.hands}}</div>
      <div>{{weapon.length}}</div>
      <div>{{weapon.skillUsed}}</div>
      <div>{{weapon.attackTable}}</div>
      <div>{{weapon.primaryCritical}}</div>
    </div>
    {{/each}}
    {{else}}
    <div class="empty-state">{{localize "VSD.Combat.NoWeapons"}}</div>
    {{/if}}
  </span>

</section>
