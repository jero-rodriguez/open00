<section class="tab overview" data-group="primary" data-tab="overview">

  {{!-- Passions Block (top, spanning full width like Roll20) --}}
  <div class="passions-block">
    <h3>{{localize "VSD.Overview.Passions"}}</h3>
    <div class="passions-grid">
      <label class="field-label">{{localize "VSD.Passions.Motivation"}}</label>
      <span class="field-input">
        <input type="text" name="system.passions.motivation" value="{{passions.motivation}}" class="passions-text-field" />
      </span>
      <label class="field-label">{{localize "VSD.Passions.Nature"}}</label>
      <span class="field-input">
        <input type="text" name="system.passions.nature" value="{{passions.nature}}" class="passions-text-field" />
      </span>
      <label class="field-label">{{localize "VSD.Passions.Allegiance"}}</label>
      <span class="field-input">
        <input type="text" name="system.passions.allegiance" value="{{passions.allegiance}}" class="passions-text-field" />
      </span>
    </div>
  </div>

  {{!-- Main two-column layout (mirroring Roll20 left/right split) --}}
  <div class="main-grid-section">

    {{!-- Left Column: Drive Points, Heroic Path, Stats, Save Rolls --}}
    <div class="leftside">

      {{!-- Drive Points --}}
      <div class="drive-points">
        <h3>{{localize "VSD.Overview.DrivePoints"}}</h3>
        <div class="drive-points-display">
          <input type="number" name="system.drivePoints.value" value="{{drivePoints.value}}" class="drive-current" />
          <span class="separator">/</span>
          <input type="number" name="system.drivePoints.max" value="{{drivePoints.max}}" class="drive-max" />
        </div>
      </div>

      {{!-- Heroic Path --}}
      <div class="heroic-path">
        <h3>{{localize "VSD.Overview.HeroicPath"}}</h3>
        <input type="text" name="system.heroicPath" value="{{heroicPath}}" class="heroic-path-field" />
      </div>

      {{!-- Stats Block (table format like Roll20: Name, Abbr, Value/Total) --}}
      <div class="stats-block">
        <h3>{{localize "VSD.Overview.Stats"}}</h3>
        <div class="stats-table">
          <div class="stats-row stats-header">
            <div class="stats-cell">{{localize "VSD.Stats.Header.Name"}}</div>
            <div class="stats-cell">{{localize "VSD.Stats.Header.Abbr"}}</div>
            <div class="stats-cell">{{localize "VSD.Stats.Header.Total"}}</div>
          </div>
          <div class="stats-row">
            <div class="stats-cell stats-name-cell">
              <span class="stats-name" title="Brawn is character's muscular strength and physical power">{{localize "VSD.Stats.Brawn"}}</span>
            </div>
            <div class="stats-cell stat-abbr"><span class="stats-name">brn</span></div>
            <div class="stats-cell">
              <input type="number" name="system.stats.brn" value="{{stats.brn}}" class="stat-input" />
            </div>
          </div>
          <div class="stats-row">
            <div class="stats-cell stats-name-cell">
              <span class="stats-name" title="Swiftness is character's dexterity, speed, coordination, balance and general agility">{{localize "VSD.Stats.Swiftness"}}</span>
            </div>
            <div class="stats-cell stat-abbr"><span class="stats-name">swi</span></div>
            <div class="stats-cell">
              <input type="number" name="system.stats.swi" value="{{stats.swi}}" class="stat-input" />
            </div>
          </div>
          <div class="stats-row">
            <div class="stats-cell stats-name-cell">
              <span class="stats-name" title="Fortitude is character's resistance and vigor">{{localize "VSD.Stats.Fortitude"}}</span>
            </div>
            <div class="stats-cell stat-abbr"><span class="stats-name">for</span></div>
            <div class="stats-cell">
              <input type="number" name="system.stats.for" value="{{stats.for}}" class="stat-input" />
            </div>
          </div>
          <div class="stats-row">
            <div class="stats-cell stats-name-cell">
              <span class="stats-name" title="Wits is character's reasoning, cleverness, and mental agility">{{localize "VSD.Stats.Wits"}}</span>
            </div>
            <div class="stats-cell stat-abbr"><span class="stats-name">wit</span></div>
            <div class="stats-cell">
              <input type="number" name="system.stats.wit" value="{{stats.wit}}" class="stat-input" />
            </div>
          </div>
          <div class="stats-row">
            <div class="stats-cell stats-name-cell">
              <span class="stats-name" title="Wisdom is character's empathy, intuition, willpower, and awareness">{{localize "VSD.Stats.Wisdom"}}</span>
            </div>
            <div class="stats-cell stat-abbr"><span class="stats-name">wsd</span></div>
            <div class="stats-cell">
              <input type="number" name="system.stats.wsd" value="{{stats.wsd}}" class="stat-input" />
            </div>
          </div>
          <div class="stats-row">
            <div class="stats-cell stats-name-cell">
              <span class="stats-name" title="Bearing is character's presence, charisma, and social influence">{{localize "VSD.Stats.Bearing"}}</span>
            </div>
            <div class="stats-cell stat-abbr"><span class="stats-name">bea</span></div>
            <div class="stats-cell">
              <input type="number" name="system.stats.bea" value="{{stats.bea}}" class="stat-input" />
            </div>
          </div>
        </div>
      </div>

    </div>

    {{!-- Right Column: HP/MP vitals summary --}}
    <div class="rightside">

      {{!-- Hit Points --}}
      <div class="vitals-block">
        <h3>{{localize "VSD.Overview.HitPoints"}}</h3>
        <div class="vitals-display">
          <div class="vital-pair">
            <input type="number" name="system.hp.value" value="{{hp.value}}" class="vital-current" />
            <span class="vital-label">{{localize "VSD.Overview.Current"}}</span>
          </div>
          <span class="separator">/</span>
          <div class="vital-pair">
            <input type="number" name="system.hp.max" value="{{hp.max}}" class="vital-max" />
            <span class="vital-label">{{localize "VSD.Overview.Max"}}</span>
          </div>
        </div>
      </div>

      {{!-- Magic Points --}}
      <div class="vitals-block">
        <h3>{{localize "VSD.Overview.MagicPoints"}}</h3>
        <div class="vitals-display">
          <div class="vital-pair">
            <input type="number" name="system.mp.value" value="{{mp.value}}" class="vital-current" />
            <span class="vital-label">{{localize "VSD.Overview.Current"}}</span>
          </div>
          <span class="separator">/</span>
          <div class="vital-pair">
            <input type="number" name="system.mp.max" value="{{mp.max}}" class="vital-max" />
            <span class="vital-label">{{localize "VSD.Overview.Max"}}</span>
          </div>
        </div>
      </div>

      {{!-- Defense --}}
      <div class="vitals-block">
        <h3>{{localize "VSD.Overview.Defense"}}</h3>
        <div class="defense-display">
          <input type="number" name="system.defense" value="{{defense}}" class="defense-input" />
        </div>
      </div>

      {{!-- Encumbrance --}}
      <div class="vitals-block">
        <h3>{{localize "VSD.Overview.Encumbrance"}}</h3>
        <div class="encumbrance-display">
          <span class="encumbrance-level">{{encumbrance}}</span>
        </div>
      </div>

      {{!-- Wealth --}}
      <div class="vitals-block">
        <h3>{{localize "VSD.Overview.Wealth"}}</h3>
        <div class="wealth-display">
          <input type="number" name="system.wealth" value="{{wealth}}" min="0" max="5" class="wealth-input" />
        </div>
      </div>

    </div>
  </div>
</section>
