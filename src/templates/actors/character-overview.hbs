<section class="tab overview {{tab.cssClass}} open00-tab-scroll" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <section class="sheet-section passions-section">
    <h2 class="section-title">{{localize "OPEN00.Overview.Passions"}}</h2>
    <div class="passions-grid">
      <label for="open00-motivation">{{localize "OPEN00.Passions.Motivation"}}</label>
      <input id="open00-motivation" type="text" name="system.passions.motivation" value="{{passions.motivation}}" autocomplete="off" />
      <label for="open00-nature">{{localize "OPEN00.Passions.Nature"}}</label>
      <input id="open00-nature" type="text" name="system.passions.nature" value="{{passions.nature}}" autocomplete="off" />
      <label for="open00-allegiance">{{localize "OPEN00.Passions.Allegiance"}}</label>
      <input id="open00-allegiance" type="text" name="system.passions.allegiance" value="{{passions.allegiance}}" autocomplete="off" />
    </div>
  </section>

  <div class="overview-grid">
    <aside class="overview-sidebar">
      <section class="sheet-section drive-section">
        <h2 class="section-title section-title-with-control">
          <span>{{localize "OPEN00.Overview.DrivePoints"}}</span>
          <span class="drive-pips" aria-label="{{localize 'OPEN00.Overview.DrivePoints'}}">
            {{#each drivePips}}
            <button type="button" class="drive-pip {{#if active}}active{{/if}}" data-action="setDrivePoints" data-value="{{value}}" title="{{value}}"></button>
            {{/each}}
          </span>
        </h2>
        <div class="inline-track-fields">
          <label>{{localize "OPEN00.Overview.Current"}} <input type="number" name="system.drivePoints.value" value="{{drivePoints.value}}" min="0" max="{{drivePoints.max}}" /></label>
          <span>/</span>
          <label>{{localize "OPEN00.Overview.Max"}} <input type="number" name="system.drivePoints.max" value="{{drivePoints.max}}" min="0" /></label>
        </div>
      </section>

      <section class="sheet-section">
        <h2 class="section-title">{{localize "OPEN00.Overview.HeroicPath"}}</h2>
        <input class="heroic-path-input" type="text" name="system.heroicPath" value="{{heroicPath}}" autocomplete="off" />
      </section>

      <section class="sheet-section">
        <h2 class="section-title">{{localize "OPEN00.Overview.Stats"}}</h2>
        <div class="rules-table stats-table">
          <div class="table-row table-heading">
            <span>{{localize "OPEN00.Stats.Header.Name"}}</span>
            <span>{{localize "OPEN00.Stats.Header.Abbr"}}</span>
            <span>{{localize "OPEN00.Stats.Header.Base"}}</span>
            <span>{{localize "OPEN00.Stats.Header.Kin"}}</span>
            <span>{{localize "OPEN00.Stats.Header.Spec"}}</span>
            <span>{{localize "OPEN00.Stats.Header.Total"}}</span>
          </div>
          <label class="table-row"><span>{{localize "OPEN00.Stats.Brawn"}}</span><abbr>BRN</abbr><input type="number" name="system.stats.brn.base" value="{{stats.brn.base}}" /><input type="number" name="system.stats.brn.kin" value="{{stats.brn.kin}}" /><input type="number" name="system.stats.brn.spec" value="{{stats.brn.spec}}" /><strong>{{stats.brn.total}}</strong></label>
          <label class="table-row"><span>{{localize "OPEN00.Stats.Swiftness"}}</span><abbr>SWI</abbr><input type="number" name="system.stats.swi.base" value="{{stats.swi.base}}" /><input type="number" name="system.stats.swi.kin" value="{{stats.swi.kin}}" /><input type="number" name="system.stats.swi.spec" value="{{stats.swi.spec}}" /><strong>{{stats.swi.total}}</strong></label>
          <label class="table-row"><span>{{localize "OPEN00.Stats.Fortitude"}}</span><abbr>FOR</abbr><input type="number" name="system.stats.for.base" value="{{stats.for.base}}" /><input type="number" name="system.stats.for.kin" value="{{stats.for.kin}}" /><input type="number" name="system.stats.for.spec" value="{{stats.for.spec}}" /><strong>{{stats.for.total}}</strong></label>
          <label class="table-row"><span>{{localize "OPEN00.Stats.Wits"}}</span><abbr>WIT</abbr><input type="number" name="system.stats.wit.base" value="{{stats.wit.base}}" /><input type="number" name="system.stats.wit.kin" value="{{stats.wit.kin}}" /><input type="number" name="system.stats.wit.spec" value="{{stats.wit.spec}}" /><strong>{{stats.wit.total}}</strong></label>
          <label class="table-row"><span>{{localize "OPEN00.Stats.Wisdom"}}</span><abbr>WSD</abbr><input type="number" name="system.stats.wsd.base" value="{{stats.wsd.base}}" /><input type="number" name="system.stats.wsd.kin" value="{{stats.wsd.kin}}" /><input type="number" name="system.stats.wsd.spec" value="{{stats.wsd.spec}}" /><strong>{{stats.wsd.total}}</strong></label>
          <label class="table-row"><span>{{localize "OPEN00.Stats.Bearing"}}</span><abbr>BEA</abbr><input type="number" name="system.stats.bea.base" value="{{stats.bea.base}}" /><input type="number" name="system.stats.bea.kin" value="{{stats.bea.kin}}" /><input type="number" name="system.stats.bea.spec" value="{{stats.bea.spec}}" /><strong>{{stats.bea.total}}</strong></label>
        </div>
      </section>

      <section class="sheet-section">
        <h2 class="section-title">{{localize "OPEN00.Overview.SaveRolls"}}</h2>
        <div class="rules-table saves-table">
          <div class="table-row table-heading">
            <span>{{localize "OPEN00.Saves.RollName"}}</span>
            <span>{{localize "OPEN00.Saves.Stat"}}</span>
            <span>{{localize "OPEN00.Stats.Header.Total"}}</span>
          </div>
          <div class="table-row"><span>{{localize "OPEN00.Saves.Toughness"}}</span><abbr>FOR</abbr><strong>{{saveRolls.toughness}}</strong></div>
          <div class="table-row"><span>{{localize "OPEN00.Saves.Willpower"}}</span><abbr>WSD</abbr><strong>{{saveRolls.willpower}}</strong></div>
        </div>
      </section>
    </aside>

    <main class="skills-panel sheet-section">
      <h2 class="section-title">{{localize "OPEN00.Skills.Title"}}</h2>
      <div class="skills-table skills-heading" aria-hidden="true">
        <span>{{localize "OPEN00.Skills.Name"}}</span>
        <span>{{localize "OPEN00.Skills.StatBonusShort"}}</span>
        <span>{{localize "OPEN00.Skills.Stat"}}</span>
        <span>#</span>
        <span>{{localize "OPEN00.Skills.RankBonusShort"}}</span>
        <span>{{localize "OPEN00.Skills.ItemBonusShort"}}</span>
        <span>{{localize "OPEN00.Skills.Total"}}</span>
        <span></span>
      </div>

      {{#each skillCategories}}
      <section class="skill-category">
        <h3>{{localize label}}</h3>
        {{#each skills}}
        <div class="skills-table skill-row">
          <button type="button" class="skill-name roll-link" data-action="rollSkill" data-skill-name="{{name}}" data-skill-bonus="{{totalBonus}}" data-stat-key="{{statKey}}" data-category="{{../id}}" title="{{localize 'OPEN00.Skills.RollTooltip'}}">{{name}}</button>
          <span class="computed-cell">{{statBonusDisplay}}</span>
          <abbr title="{{localize statLabel}}">{{statKey}}</abbr>
          <input type="number" name="system.skills.{{index}}.rank" value="{{rank}}" min="0" max="30" aria-label="{{localize 'OPEN00.Skills.Rank'}}" />
          <span class="computed-cell">{{rankBonusDisplay}}</span>
          <input type="number" name="system.skills.{{index}}.itemModifiers" value="{{itemModifiers}}" aria-label="{{localize 'OPEN00.Skills.ItemBonusShort'}}" />
          <strong class="total-cell">{{totalBonusDisplay}}</strong>
          <button type="button" class="icon-button roll-skill" data-action="rollSkill" data-skill-name="{{name}}" data-skill-bonus="{{totalBonus}}" data-stat-key="{{statKey}}" data-category="{{../id}}" title="{{localize 'OPEN00.Skills.RollTooltip'}}"><i class="fas fa-dice-d100" aria-hidden="true"></i></button>
        </div>
        {{/each}}
      </section>
      {{else}}
      <p class="empty-state">{{localize "OPEN00.Skills.NoSkills"}}</p>
      {{/each}}
    </main>
  </div>
</section>
