<section class="tab overview {{tab.cssClass}} open00-tab-scroll" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <section class="sheet-section passions-section">
    <h2 class="section-title">{{localize "OPEN00.Overview.Passions"}}</h2>
    <div class="passions-grid">
      <label for="open00-motivation">{{localize "OPEN00.Passions.Motivation"}}</label>
      <input id="open00-motivation" type="text" name="system.passions.motivation" value="{{passions.motivation}}" autocomplete="off" />
      <label for="open00-nature">{{localize "OPEN00.Passions.Nature"}}</label>
      <input id="open00-nature" type="text" name="system.passions.nature" value="{{passions.nature}}" autocomplete="off" />
      <label for="open00-allegiance">{{localize "OPEN00.Passions.Allegiance"}}</label>
      <input id="open00-allegiance" type="text" name="system.passions.allegiance" value="{{passions.allegiance}}" autocomplete="off" />
    </div>
  </section>

  <div class="overview-two-column">
    {{!-- Left Column: Drive Points, Heroic Path, Stats, Save Rolls, Special Abilities, Background Options, Known Languages --}}
    <div class="overview-left-column">

      {{!-- Drive Points with Dice Roller --}}
      <section class="sheet-section">
        <h2 class="section-title section-title-with-control">
          <span>{{localize "OPEN00.Overview.DrivePoints"}}</span>
          <span class="drive-pips" aria-label="{{localize 'OPEN00.Overview.DrivePoints'}}">
            {{#each drivePips}}
            <button type="button" class="drive-pip {{#if active}}active{{/if}}" data-action="setDrivePoints" data-value="{{value}}" title="{{value}}"></button>
            {{/each}}
          </span>
        </h2>
        <div class="dice-roller-buttons">
          <button type="button" class="dice-button" data-action="rollDice" data-dice="d5" title="Roll d5">
            <span class="dice-label">d5</span>
          </button>
          <button type="button" class="dice-button" data-action="rollDice" data-dice="d10" title="Roll d10">
            <span class="dice-label">d10</span>
          </button>
          <button type="button" class="dice-button" data-action="rollDice" data-dice="d100" title="Roll d100">
            <span class="dice-label">d100</span>
          </button>
          <button type="button" class="dice-button" data-action="rollDice" data-dice="d100oe" title="Roll d100 Open-Ended">
            <span class="dice-label">d100*</span>
          </button>
        </div>
      </section>

      {{!-- Heroic Path --}}
      <section class="sheet-section">
        <h2 class="section-title">{{localize "OPEN00.Overview.HeroicPath"}}</h2>
        {{#each heroicPathItems}}
        <div class="list-entry">
          <span class="list-entry-text">{{this}}</span>
        </div>
        {{else}}
        <p class="empty-state compact">—</p>
        {{/each}}
        <input type="hidden" name="system.heroicPath" value="{{heroicPath}}" />
      </section>

      {{!-- Stats --}}
      <section class="sheet-section">
        <h2 class="section-title">{{localize "OPEN00.Overview.Stats"}}</h2>
        <div class="rules-table stats-table">
          <div class="table-row table-heading">
            <span>{{localize "OPEN00.Stats.Header.Name"}}</span>
            <span>{{localize "OPEN00.Stats.Header.Abbr"}}</span>
            <span>{{localize "OPEN00.Stats.Header.Base"}}</span>
            <span>{{localize "OPEN00.Stats.Header.Kin"}}</span>
            <span>{{localize "OPEN00.Stats.Header.Spec"}}</span>
            <span>{{localize "OPEN00.Stats.Header.Total"}}</span>
          </div>
          <label class="table-row"><button type="button" class="roll-link roll-name stat-roll" data-action="rollStat" data-stat-key="brn" data-stat-bonus="{{stats.brn.total}}" title="{{localize 'OPEN00.Stats.RollTooltip'}}"><span class="roll-name-label">{{localize "OPEN00.Stats.Brawn"}}</span><i class="fas fa-dice-d100 roll-name-icon" aria-hidden="true"></i></button><abbr>BRN</abbr><input type="number" name="system.stats.brn.base" value="{{stats.brn.base}}" /><input type="number" name="system.stats.brn.kin" value="{{stats.brn.kin}}" /><input type="number" name="system.stats.brn.spec" value="{{stats.brn.spec}}" /><strong>{{stats.brn.total}}</strong></label>
          <label class="table-row"><button type="button" class="roll-link roll-name stat-roll" data-action="rollStat" data-stat-key="swi" data-stat-bonus="{{stats.swi.total}}" title="{{localize 'OPEN00.Stats.RollTooltip'}}"><span class="roll-name-label">{{localize "OPEN00.Stats.Swiftness"}}</span><i class="fas fa-dice-d100 roll-name-icon" aria-hidden="true"></i></button><abbr>SWI</abbr><input type="number" name="system.stats.swi.base" value="{{stats.swi.base}}" /><input type="number" name="system.stats.swi.kin" value="{{stats.swi.kin}}" /><input type="number" name="system.stats.swi.spec" value="{{stats.swi.spec}}" /><strong>{{stats.swi.total}}</strong></label>
          <label class="table-row"><button type="button" class="roll-link roll-name stat-roll" data-action="rollStat" data-stat-key="for" data-stat-bonus="{{stats.for.total}}" title="{{localize 'OPEN00.Stats.RollTooltip'}}"><span class="roll-name-label">{{localize "OPEN00.Stats.Fortitude"}}</span><i class="fas fa-dice-d100 roll-name-icon" aria-hidden="true"></i></button><abbr>FOR</abbr><input type="number" name="system.stats.for.base" value="{{stats.for.base}}" /><input type="number" name="system.stats.for.kin" value="{{stats.for.kin}}" /><input type="number" name="system.stats.for.spec" value="{{stats.for.spec}}" /><strong>{{stats.for.total}}</strong></label>
          <label class="table-row"><button type="button" class="roll-link roll-name stat-roll" data-action="rollStat" data-stat-key="wit" data-stat-bonus="{{stats.wit.total}}" title="{{localize 'OPEN00.Stats.RollTooltip'}}"><span class="roll-name-label">{{localize "OPEN00.Stats.Wits"}}</span><i class="fas fa-dice-d100 roll-name-icon" aria-hidden="true"></i></button><abbr>WIT</abbr><input type="number" name="system.stats.wit.base" value="{{stats.wit.base}}" /><input type="number" name="system.stats.wit.kin" value="{{stats.wit.kin}}" /><input type="number" name="system.stats.wit.spec" value="{{stats.wit.spec}}" /><strong>{{stats.wit.total}}</strong></label>
          <label class="table-row"><button type="button" class="roll-link roll-name stat-roll" data-action="rollStat" data-stat-key="wsd" data-stat-bonus="{{stats.wsd.total}}" title="{{localize 'OPEN00.Stats.RollTooltip'}}"><span class="roll-name-label">{{localize "OPEN00.Stats.Wisdom"}}</span><i class="fas fa-dice-d100 roll-name-icon" aria-hidden="true"></i></button><abbr>WSD</abbr><input type="number" name="system.stats.wsd.base" value="{{stats.wsd.base}}" /><input type="number" name="system.stats.wsd.kin" value="{{stats.wsd.kin}}" /><input type="number" name="system.stats.wsd.spec" value="{{stats.wsd.spec}}" /><strong>{{stats.wsd.total}}</strong></label>
          <label class="table-row"><button type="button" class="roll-link roll-name stat-roll" data-action="rollStat" data-stat-key="bea" data-stat-bonus="{{stats.bea.total}}" title="{{localize 'OPEN00.Stats.RollTooltip'}}"><span class="roll-name-label">{{localize "OPEN00.Stats.Bearing"}}</span><i class="fas fa-dice-d100 roll-name-icon" aria-hidden="true"></i></button><abbr>BEA</abbr><input type="number" name="system.stats.bea.base" value="{{stats.bea.base}}" /><input type="number" name="system.stats.bea.kin" value="{{stats.bea.kin}}" /><input type="number" name="system.stats.bea.spec" value="{{stats.bea.spec}}" /><strong>{{stats.bea.total}}</strong></label>
        </div>
      </section>

      {{!-- Save Rolls --}}
      <section class="sheet-section">
        <h2 class="section-title">{{localize "OPEN00.Overview.SaveRolls"}}</h2>
        <div class="rules-table saves-table">
          <div class="table-row table-heading">
            <span>{{localize "OPEN00.Saves.RollName"}}</span>
            <span>{{localize "OPEN00.Saves.Stat"}}</span>
            <span>{{localize "OPEN00.Stats.Header.Kin"}}</span>
            <span>{{localize "OPEN00.Stats.Header.Spec"}}</span>
            <span>{{localize "OPEN00.Saves.Level"}}</span>
            <span>{{localize "OPEN00.Saves.KinBonus"}}</span>
            <span>{{localize "OPEN00.Stats.Header.Total"}}</span>
          </div>
          {{#each saveRolls}}
          <div class="table-row save-row">
            <button type="button" class="roll-link roll-name save-roll" data-action="rollSave" data-save-name="{{this.name}}" data-save-bonus="{{this.total}}" title="{{localize 'OPEN00.Saves.RollTooltip'}}"><span class="roll-name-label">{{localize this.name}}</span><i class="fas fa-dice-d100 roll-name-icon" aria-hidden="true"></i></button>
            <span><strong>{{this.statBase}}</strong></span>
            <span>{{this.kin}}</span>
            <span>{{this.spec}}</span>
            <span>{{this.level}}</span>
            <span>{{this.kinBonus}}</span>
            <strong>{{this.total}}</strong>
          </div>
          {{/each}}
        </div>
      </section>

      {{!-- Special Abilities --}}
      <section class="sheet-section">
        <h2 class="section-title">{{localize "OPEN00.Overview.SpecialAbilities"}}</h2>
        {{#each specialAbilities}}
        <div class="list-entry">
          <span class="list-entry-text">{{this}}</span>
        </div>
        {{else}}
        <p class="empty-state compact">{{localize "OPEN00.Overview.NoSpecialAbilities"}}</p>
        {{/each}}
        <div class="list-actions">
          <button type="button" class="list-action-button" data-action="addSpecialAbility">{{localize "OPEN00.Overview.Add"}}</button>
          <button type="button" class="list-action-button" data-action="modifySpecialAbilities">{{localize "OPEN00.Overview.Modify"}}</button>
        </div>
      </section>

      {{!-- Background Options --}}
      <section class="sheet-section">
        <h2 class="section-title">{{localize "OPEN00.Overview.BackgroundOptions"}}</h2>
        {{#each backgroundOptions}}
        <div class="list-entry">
          <span class="list-entry-text">{{this.name}}</span>
        </div>
        {{else}}
        <p class="empty-state compact">{{localize "OPEN00.Overview.NoBackgroundOptions"}}</p>
        {{/each}}
        <div class="list-actions">
          <button type="button" class="list-action-button" data-action="addBackgroundOption">{{localize "OPEN00.Overview.Add"}}</button>
          <button type="button" class="list-action-button" data-action="modifyBackgroundOptions">{{localize "OPEN00.Overview.Modify"}}</button>
        </div>
      </section>

      {{!-- Known Languages --}}
      <section class="sheet-section">
        <h2 class="section-title">{{localize "OPEN00.Overview.KnownLanguages"}}</h2>
        {{#each knownLanguages}}
        <div class="list-entry">
          <span class="list-entry-text">{{this}}</span>
        </div>
        {{else}}
        <p class="empty-state compact">{{localize "OPEN00.Overview.NoKnownLanguages"}}</p>
        {{/each}}
        <div class="list-actions">
          <button type="button" class="list-action-button" data-action="addKnownLanguage">{{localize "OPEN00.Overview.Add"}}</button>
          <button type="button" class="list-action-button" data-action="modifyKnownLanguages">{{localize "OPEN00.Overview.Modify"}}</button>
        </div>
      </section>

    </div>

    {{!-- Right Column: Skills --}}
    <main class="overview-right-column skills-panel sheet-section">
      <h2 class="section-title">{{localize "OPEN00.Skills.Title"}}</h2>
      <div class="skills-table skills-heading" aria-hidden="true">
        <span>{{localize "OPEN00.Skills.Name"}}</span>
        <span>{{localize "OPEN00.Skills.Bonus"}}</span>
        <span>{{localize "OPEN00.Skills.Stat"}}</span>
        <span>#</span>
        <span>{{localize "OPEN00.Skills.RankBonusShort"}}</span>
        <span>{{localize "OPEN00.Skills.VocationShort"}}</span>
        <span>{{localize "OPEN00.Skills.KinShort"}}</span>
        <span>{{localize "OPEN00.Skills.SpecShort"}}</span>
        <span>{{localize "OPEN00.Skills.ItemBonusShort"}}</span>
        <span>{{localize "OPEN00.Skills.Total"}}</span>
        <span></span>
      </div>

      {{#each skillCategories}}
      <section class="skill-category">
        <h3>{{localize label}}</h3>
        {{#each skills}}
        <div class="skills-table skill-row">
          <button type="button" class="skill-name roll-link" data-action="rollSkill" data-skill-name="{{name}}" data-skill-bonus="{{totalBonus}}" data-stat-key="{{statKey}}" data-category="{{../id}}" title="{{localize 'OPEN00.Skills.RollTooltip'}}">{{name}}</button>
          <span class="computed-cell">{{statBonusDisplay}}</span>
          <abbr title="{{localize statLabel}}">{{statKey}}</abbr>
          <input type="number" name="system.skills.{{index}}.rank" value="{{rank}}" min="0" max="30" aria-label="{{localize 'OPEN00.Skills.Rank'}}" />
          <span class="computed-cell">{{rankBonusDisplay}}</span>
          <input type="number" name="system.skills.{{index}}.vocation" value="{{vocation}}" aria-label="{{localize 'OPEN00.Skills.VocationShort'}}" />
          <input type="number" name="system.skills.{{index}}.kin" value="{{kin}}" aria-label="{{localize 'OPEN00.Skills.KinShort'}}" />
          <input type="number" name="system.skills.{{index}}.spec" value="{{spec}}" aria-label="{{localize 'OPEN00.Skills.SpecShort'}}" />
          <input type="number" name="system.skills.{{index}}.item" value="{{item}}" aria-label="{{localize 'OPEN00.Skills.ItemBonusShort'}}" />
          <strong class="total-cell">{{totalBonusDisplay}}</strong>
          <button type="button" class="icon-button roll-skill" data-action="rollSkill" data-skill-name="{{name}}" data-skill-bonus="{{totalBonus}}" data-stat-key="{{statKey}}" data-category="{{../id}}" title="{{localize 'OPEN00.Skills.RollTooltip'}}"><i class="fas fa-dice-d100" aria-hidden="true"></i></button>
        </div>
        {{/each}}
      </section>
      {{else}}
      <p class="empty-state">{{localize "OPEN00.Skills.NoSkills"}}</p>
      {{/each}}
    </main>
  </div>
</section>
