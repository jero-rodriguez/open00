<section class="tab open00-tab-scroll item-type-{{itemType}} {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <div class="item-fields">
    {{#if isWeapon}}
    <h3 class="section-subtitle">Notes</h3>
    {{#if editable}}
    <prose-mirror name="system.notes" value="{{source.notes}}"></prose-mirror>
    {{else}}
    <div class="editor"><div class="editor-content">{{{enrichedNotes}}}</div></div>
    {{/if}}
    {{/if}}

    {{#if isCulture}}
    <h3 class="section-subtitle">Passions Guidance</h3>
    {{#if editable}}
    <prose-mirror name="system.passionsGuidance" value="{{source.passionsGuidance}}"></prose-mirror>
    {{else}}
    <div class="editor"><div class="editor-content">{{{enrichedPassionsGuidance}}}</div></div>
    {{/if}}
    {{/if}}

    <h3 class="section-subtitle">Description</h3>
    {{#if editable}}
    <prose-mirror name="system.description" value="{{source.description}}"></prose-mirror>
    {{else}}
    <div class="editor"><div class="editor-content">{{{enrichedItemDescription}}}</div></div>
    {{/if}}
  </div>
</section>
