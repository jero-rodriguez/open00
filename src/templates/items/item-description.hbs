<section class="tab open00-tab-scroll item-type-{{itemType}} {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <div class="item-fields">
    {{#if isWeapon}}
    <h3 class="section-subtitle">Notes</h3>
    {{editor system.notes target="system.notes" button=true editable=true class="item-description-sm"}}
    {{/if}}

    {{#if isCulture}}
    <h3 class="section-subtitle">Passions Guidance</h3>
    {{editor system.passionsGuidance target="system.passionsGuidance" button=true editable=true class="item-description"}}
    {{/if}}

    <h3 class="section-subtitle">Description</h3>
    {{editor system.description target="system.description" button=true editable=true class="item-description"}}
  </div>
</section>
