<section class="tab open00-tab-scroll item-type-{{itemType}} {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <div class="item-fields">
    {{#if isWeapon}}
    <div class="field-row">
      <label class="field-label">Hands</label>
      <select name="system.hands">
        <option value="1H" {{#if (eq system.hands "1H")}}selected{{/if}}>1H</option>
        <option value="2H" {{#if (eq system.hands "2H")}}selected{{/if}}>2H</option>
      </select>
    </div>
    <div class="field-row">
      <label class="field-label">Skill(s) Used</label>
      <input type="text" name="system.skillUsed" value="{{system.skillUsed}}" />
    </div>
    <div class="field-row">
      <label class="field-label">Secondary Skill</label>
      <input type="text" name="system.secondarySkill" value="{{system.secondarySkill}}" />
    </div>
    <div class="field-row">
      <label class="field-label">Secondary Penalty</label>
      <input type="number" name="system.secondarySkillPenalty" value="{{system.secondarySkillPenalty}}" max="0" />
    </div>
    <div class="field-row">
      <label class="field-label">Clumsy Range</label>
      <input type="number" name="system.clumsyRange" value="{{system.clumsyRange}}" min="1" max="10" />
    </div>
    <div class="field-row">
      <label class="field-label">Length</label>
      <select name="system.length">
        <option value="Hand" {{#if (eq system.length "Hand")}}selected{{/if}}>Hand</option>
        <option value="Short" {{#if (eq system.length "Short")}}selected{{/if}}>Short</option>
        <option value="Long" {{#if (eq system.length "Long")}}selected{{/if}}>Long</option>
        <option value="Longest" {{#if (eq system.length "Longest")}}selected{{/if}}>Longest</option>
      </select>
    </div>
    <div class="field-row">
      <label class="field-label">Attack Table</label>
      <select name="system.attackTable">
        <option value="Edged" {{#if (eq system.attackTable "Edged")}}selected{{/if}}>Edged</option>
        <option value="Blunt" {{#if (eq system.attackTable "Blunt")}}selected{{/if}}>Blunt</option>
        <option value="Missile" {{#if (eq system.attackTable "Missile")}}selected{{/if}}>Missile</option>
        <option value="Unarmed" {{#if (eq system.attackTable "Unarmed")}}selected{{/if}}>Unarmed</option>
        <option value="Beast" {{#if (eq system.attackTable "Beast")}}selected{{/if}}>Beast</option>
      </select>
    </div>
    <div class="field-row">
      <label class="field-label">Max Result</label>
      <input type="number" name="system.maxResult" value="{{system.maxResult}}" min="80" max="175" />
    </div>
    <div class="field-row">
      <label class="field-label">Primary Critical</label>
      <select name="system.primaryCritical">
        <option value="Cut" {{#if (eq system.primaryCritical "Cut")}}selected{{/if}}>Cut</option>
        <option value="Impact" {{#if (eq system.primaryCritical "Impact")}}selected{{/if}}>Impact</option>
        <option value="Pierce" {{#if (eq system.primaryCritical "Pierce")}}selected{{/if}}>Pierce</option>
        <option value="Grapple" {{#if (eq system.primaryCritical "Grapple")}}selected{{/if}}>Grapple</option>
        <option value="Fire" {{#if (eq system.primaryCritical "Fire")}}selected{{/if}}>Fire</option>
        <option value="Frost" {{#if (eq system.primaryCritical "Frost")}}selected{{/if}}>Frost</option>
        <option value="Lightning" {{#if (eq system.primaryCritical "Lightning")}}selected{{/if}}>Lightning</option>
        <option value="DarkMagic" {{#if (eq system.primaryCritical "DarkMagic")}}selected{{/if}}>Dark Magic</option>
      </select>
    </div>
    <div class="field-row">
      <label class="field-label">Alternate Critical</label>
      <select name="system.alternateCritical">
        <option value="" {{#if (eq system.alternateCritical "")}}selected{{/if}}>None</option>
        <option value="Cut" {{#if (eq system.alternateCritical "Cut")}}selected{{/if}}>Cut</option>
        <option value="Impact" {{#if (eq system.alternateCritical "Impact")}}selected{{/if}}>Impact</option>
        <option value="Pierce" {{#if (eq system.alternateCritical "Pierce")}}selected{{/if}}>Pierce</option>
        <option value="Grapple" {{#if (eq system.alternateCritical "Grapple")}}selected{{/if}}>Grapple</option>
        <option value="Fire" {{#if (eq system.alternateCritical "Fire")}}selected{{/if}}>Fire</option>
        <option value="Frost" {{#if (eq system.alternateCritical "Frost")}}selected{{/if}}>Frost</option>
        <option value="Lightning" {{#if (eq system.alternateCritical "Lightning")}}selected{{/if}}>Lightning</option>
        <option value="DarkMagic" {{#if (eq system.alternateCritical "DarkMagic")}}selected{{/if}}>Dark Magic</option>
      </select>
    </div>
    <div class="field-row">
      <label class="field-label">Base Range (m)</label>
      <input type="number" name="system.baseRange" value="{{system.baseRange}}" min="0" />
    </div>
    {{/if}}

    {{#if isArmor}}
    <div class="field-row">
      <label class="field-label">Armor Type</label>
      <select name="system.armorType">
        <option value="NA" {{#if (eq system.armorType "NA")}}selected{{/if}}>NA</option>
        <option value="LA" {{#if (eq system.armorType "LA")}}selected{{/if}}>LA</option>
        <option value="MA" {{#if (eq system.armorType "MA")}}selected{{/if}}>MA</option>
        <option value="HA" {{#if (eq system.armorType "HA")}}selected{{/if}}>HA</option>
        <option value="Shield" {{#if (eq system.armorType "Shield")}}selected{{/if}}>Shield</option>
      </select>
    </div>

    <h3 class="section-subtitle">Penalties &amp; Bonuses</h3>
    <div class="field-row">
      <label class="field-label">Max SWI to DEF</label>
      <input type="number" name="system.maxSwiToDefense" value="{{system.maxSwiToDefense}}" min="0" max="50" />
    </div>
    <div class="field-row">
      <label class="field-label">Move Actions Penalty</label>
      <input type="number" name="system.moveActionsPenalty" value="{{system.moveActionsPenalty}}" max="0" />
    </div>
    <div class="field-row">
      <label class="field-label">CMB Penalty</label>
      <input type="number" name="system.cmbPenalty" value="{{system.cmbPenalty}}" max="0" />
    </div>
    <div class="field-row">
      <label class="field-label">Perception Penalty</label>
      <input type="number" name="system.perceptionPenalty" value="{{system.perceptionPenalty}}" max="0" />
    </div>
    <div class="field-row">
      <label class="field-label">Melee DEF Bonus</label>
      <input type="number" name="system.meleeDefenseBonus" value="{{system.meleeDefenseBonus}}" min="0" />
    </div>
    <div class="field-row">
      <label class="field-label">Missile DEF Bonus</label>
      <input type="number" name="system.missileDefenseBonus" value="{{system.missileDefenseBonus}}" min="0" />
    </div>
    {{/if}}

    {{#if isSpellLore}}
    <div class="field-row">
      <label class="field-label">Governing Stat</label>
      <select name="system.statKey">
        <option value="brn" {{#if (eq system.statKey "brn")}}selected{{/if}}>BRN</option>
        <option value="swi" {{#if (eq system.statKey "swi")}}selected{{/if}}>SWI</option>
        <option value="for" {{#if (eq system.statKey "for")}}selected{{/if}}>FOR</option>
        <option value="wit" {{#if (eq system.statKey "wit")}}selected{{/if}}>WIT</option>
        <option value="wsd" {{#if (eq system.statKey "wsd")}}selected{{/if}}>WSD</option>
        <option value="bea" {{#if (eq system.statKey "bea")}}selected{{/if}}>BEA</option>
      </select>
    </div>
    <div class="field-row">
      <label class="field-label">Access Category</label>
      <select name="system.category">
        <option value="common" {{#if (eq system.category "common")}}selected{{/if}}>Common</option>
        <option value="vocational" {{#if (eq system.category "vocational")}}selected{{/if}}>Vocational</option>
        <option value="kin" {{#if (eq system.category "kin")}}selected{{/if}}>Kin</option>
      </select>
    </div>
    {{/if}}

    {{#if isSpell}}
    <div class="field-row">
      <label class="field-label">Weave</label>
      <input type="number" name="system.weave" value="{{system.weave}}" min="1" max="10" />
    </div>
    <div class="field-row">
      <label class="field-label">Range</label>
      <input type="text" name="system.range" value="{{system.range}}" />
    </div>
    <div class="field-row">
      <label class="field-label">Duration</label>
      <input type="text" name="system.duration" value="{{system.duration}}" />
    </div>
    <div class="field-row">
      <label class="field-label">Area of Effect</label>
      <input type="text" name="system.areaOfEffect" value="{{system.areaOfEffect}}" />
    </div>
    <div class="field-row">
      <label class="field-label">Grants Save Roll</label>
      <input type="checkbox" name="system.grantsSaveRoll" {{#if system.grantsSaveRoll}}checked{{/if}} />
    </div>
    <div class="field-row">
      <label class="field-label">Instantaneous</label>
      <input type="checkbox" name="system.isInstantaneous" {{#if system.isInstantaneous}}checked{{/if}} />
    </div>
    <div class="field-row">
      <label class="field-label">Attack Spell</label>
      <input type="checkbox" name="system.isAttackSpell" {{#if system.isAttackSpell}}checked{{/if}} />
    </div>
    <div class="field-row">
      <label class="field-label">Attack Type</label>
      <select name="system.attackType">
        <option value="" {{#if (eq system.attackType "")}}selected{{/if}}>None</option>
        <option value="bolt" {{#if (eq system.attackType "bolt")}}selected{{/if}}>Bolt</option>
        <option value="area" {{#if (eq system.attackType "area")}}selected{{/if}}>Area</option>
      </select>
    </div>
    <div class="field-row">
      <label class="field-label">Resonance Type</label>
      <select name="system.resonanceType">
        <option value="healing" {{#if (eq system.resonanceType "healing")}}selected{{/if}}>Healing</option>
        <option value="spirit" {{#if (eq system.resonanceType "spirit")}}selected{{/if}}>Spirit</option>
        <option value="light" {{#if (eq system.resonanceType "light")}}selected{{/if}}>Light</option>
        <option value="natural" {{#if (eq system.resonanceType "natural")}}selected{{/if}}>Natural</option>
        <option value="elven" {{#if (eq system.resonanceType "elven")}}selected{{/if}}>Elven</option>
        <option value="illusory" {{#if (eq system.resonanceType "illusory")}}selected{{/if}}>Illusory</option>
        <option value="attack" {{#if (eq system.resonanceType "attack")}}selected{{/if}}>Attack</option>
        <option value="dark" {{#if (eq system.resonanceType "dark")}}selected{{/if}}>Dark</option>
        <option value="other" {{#if (eq system.resonanceType "other")}}selected{{/if}}>Other</option>
      </select>
    </div>
    <div class="field-row">
      <label class="field-label">Failure Severity</label>
      <select name="system.failureSeverity">
        <option value="0" {{#if (eq system.failureSeverity 0)}}selected{{/if}}>0 (Safest)</option>
        <option value="10" {{#if (eq system.failureSeverity 10)}}selected{{/if}}>10</option>
        <option value="20" {{#if (eq system.failureSeverity 20)}}selected{{/if}}>20</option>
        <option value="30" {{#if (eq system.failureSeverity 30)}}selected{{/if}}>30</option>
        <option value="50" {{#if (eq system.failureSeverity 50)}}selected{{/if}}>50 (Most Dangerous)</option>
      </select>
    </div>
    {{/if}}

    {{#if isEquipment}}
    <div class="field-row">
      <label class="field-label">Quantity</label>
      <input type="number" name="system.quantity" value="{{system.quantity}}" min="0" max="999" />
    </div>
    {{/if}}

    {{#if isKin}}
    <h3 class="section-subtitle">Stat Modifiers</h3>
    <div class="field-row">
      <label class="field-label">BRN</label>
      <input type="number" name="system.statModifiers.brn" value="{{system.statModifiers.brn}}" />
    </div>
    <div class="field-row">
      <label class="field-label">SWI</label>
      <input type="number" name="system.statModifiers.swi" value="{{system.statModifiers.swi}}" />
    </div>
    <div class="field-row">
      <label class="field-label">FOR</label>
      <input type="number" name="system.statModifiers.for" value="{{system.statModifiers.for}}" />
    </div>
    <div class="field-row">
      <label class="field-label">WIT</label>
      <input type="number" name="system.statModifiers.wit" value="{{system.statModifiers.wit}}" />
    </div>
    <div class="field-row">
      <label class="field-label">WSD</label>
      <input type="number" name="system.statModifiers.wsd" value="{{system.statModifiers.wsd}}" />
    </div>
    <div class="field-row">
      <label class="field-label">BEA</label>
      <input type="number" name="system.statModifiers.bea" value="{{system.statModifiers.bea}}" />
    </div>

    <h3 class="section-subtitle">Vitals</h3>
    <div class="field-row">
      <label class="field-label">HP Bonus</label>
      <input type="number" name="system.hpBonus" value="{{system.hpBonus}}" />
    </div>
    <div class="field-row">
      <label class="field-label">Max HP</label>
      <input type="number" name="system.maxHp" value="{{system.maxHp}}" min="0" />
    </div>
    <div class="field-row">
      <label class="field-label">MP Bonus</label>
      <input type="number" name="system.mpBonus" value="{{system.mpBonus}}" min="0" />
    </div>
    <div class="field-row">
      <label class="field-label">TSR</label>
      <input type="number" name="system.tsr" value="{{system.tsr}}" />
    </div>
    <div class="field-row">
      <label class="field-label">WSR</label>
      <input type="number" name="system.wsr" value="{{system.wsr}}" />
    </div>
    <div class="field-row">
      <label class="field-label">Background Points</label>
      <input type="number" name="system.backgroundPoints" value="{{system.backgroundPoints}}" min="0" />
    </div>
    <div class="field-row">
      <label class="field-label">Starting Wealth</label>
      <input type="number" name="system.startingWealth" value="{{system.startingWealth}}" min="0" max="5" />
    </div>

    {{#if system.specialTraits.length}}
    <h3 class="section-subtitle">Special Traits</h3>
    <div class="item-array-list">
      {{#each system.specialTraits}}
      <div class="array-row">
        <span class="array-label">{{this.name}}</span>
        <span class="array-value">{{this.description}}</span>
      </div>
      {{/each}}
    </div>
    {{/if}}

    {{#if system.suggestedCultures.length}}
    <h3 class="section-subtitle">Suggested Cultures</h3>
    <div class="item-array-list">
      {{#each system.suggestedCultures}}
      <div class="array-row">
        <span class="array-value">{{this}}</span>
      </div>
      {{/each}}
    </div>
    {{/if}}
    {{/if}}

    {{#if isCulture}}
    <div class="field-row">
      <label class="field-label">Starting Wealth</label>
      <input type="number" name="system.startingWealth" value="{{system.startingWealth}}" min="0" max="5" />
    </div>
    <div class="field-row">
      <label class="field-label">Spell Lore Ranks</label>
      <input type="number" name="system.spellLoreRanks" value="{{system.spellLoreRanks}}" min="0" max="3" />
    </div>

    {{#if system.skillRankAllocations.length}}
    <h3 class="section-subtitle">Skill Rank Allocations</h3>
    <div class="item-array-list">
      {{#each system.skillRankAllocations}}
      <div class="array-row">
        <span class="array-label">{{this.skillName}}</span>
        <span class="array-value">{{this.ranks}}</span>
      </div>
      {{/each}}
    </div>
    {{/if}}

    {{#if system.availableSpellLores.length}}
    <h3 class="section-subtitle">Available Spell Lores</h3>
    <div class="item-array-list">
      {{#each system.availableSpellLores}}
      <div class="array-row">
        <span class="array-value">{{this}}</span>
      </div>
      {{/each}}
    </div>
    {{/if}}

    {{#if system.outfitting.length}}
    <h3 class="section-subtitle">Outfitting</h3>
    <div class="item-array-list">
      {{#each system.outfitting}}
      <div class="array-row">
        <span class="array-label">{{this.group}}</span>
        <span class="array-value">{{this.options}}</span>
      </div>
      {{/each}}
    </div>
    {{/if}}
    {{/if}}

    {{#if isVocation}}
    <h3 class="section-subtitle">Development Points</h3>
    <div class="field-row">
      <label class="field-label">Armor</label>
      <input type="number" name="system.developmentPoints.armor" value="{{system.developmentPoints.armor}}" min="0" />
    </div>
    <div class="field-row">
      <label class="field-label">Combat</label>
      <input type="number" name="system.developmentPoints.combat" value="{{system.developmentPoints.combat}}" min="0" />
    </div>
    <div class="field-row">
      <label class="field-label">Adventuring</label>
      <input type="number" name="system.developmentPoints.adventuring" value="{{system.developmentPoints.adventuring}}" min="0" />
    </div>
    <div class="field-row">
      <label class="field-label">Roguery</label>
      <input type="number" name="system.developmentPoints.roguery" value="{{system.developmentPoints.roguery}}" min="0" />
    </div>
    <div class="field-row">
      <label class="field-label">Lore</label>
      <input type="number" name="system.developmentPoints.lore" value="{{system.developmentPoints.lore}}" min="0" />
    </div>
    <div class="field-row">
      <label class="field-label">Spells</label>
      <input type="number" name="system.developmentPoints.spells" value="{{system.developmentPoints.spells}}" min="0" />
    </div>
    <div class="field-row">
      <label class="field-label">Body</label>
      <input type="number" name="system.developmentPoints.body" value="{{system.developmentPoints.body}}" min="0" />
    </div>

    <div class="field-row">
      <label class="field-label">MP Per Level</label>
      <input type="number" name="system.magicPointsPerLevel" value="{{system.magicPointsPerLevel}}" min="0" />
    </div>

    {{#if system.vocationalBonuses.length}}
    <h3 class="section-subtitle">Vocational Bonuses</h3>
    <div class="item-array-list">
      {{#each system.vocationalBonuses}}
      <div class="array-row">
        <span class="array-label">{{this.skillName}}</span>
        <span class="array-value">+{{this.bonus}}</span>
      </div>
      {{/each}}
    </div>
    {{/if}}

    {{#if system.combatSkillChoices.length}}
    <h3 class="section-subtitle">Combat Skill Choices</h3>
    <div class="item-array-list">
      {{#each system.combatSkillChoices}}
      <div class="array-row">
        <span class="array-value">+{{this}}</span>
      </div>
      {{/each}}
    </div>
    {{/if}}

    {{#if system.vocationalSpellLores.length}}
    <h3 class="section-subtitle">Vocational Spell Lores</h3>
    <div class="item-array-list">
      {{#each system.vocationalSpellLores}}
      <div class="array-row">
        <span class="array-value">{{this}}</span>
      </div>
      {{/each}}
    </div>
    {{/if}}
    {{/if}}

    {{#if isTrait}}
    <div class="field-row field-row--checkbox">
      <input type="checkbox" name="system.grantsVision" {{#if system.grantsVision}}checked{{/if}} />
      <label>Grants Vision</label>
    </div>
    <div class="field-row">
      <label class="field-label">Vision Type</label>
      <select name="system.visionType">
        <option value="" {{#if (eq system.visionType "")}}selected{{/if}}>None</option>
        <option value="DarkSight" {{#if (eq system.visionType "DarkSight")}}selected{{/if}}>Dark Sight</option>
        <option value="NightSight" {{#if (eq system.visionType "NightSight")}}selected{{/if}}>Night Sight</option>
        <option value="StarSight" {{#if (eq system.visionType "StarSight")}}selected{{/if}}>Star Sight</option>
      </select>
    </div>
    <div class="field-row field-row--checkbox">
      <input type="checkbox" name="system.isRestriction" {{#if system.isRestriction}}checked{{/if}} />
      <label>Is Restriction</label>
    </div>
    <div class="field-row">
      <label class="field-label">Restriction Description</label>
      <input type="text" name="system.restrictionDescription" value="{{system.restrictionDescription}}" />
    </div>
    <div class="field-row">
      <label class="field-label">Granted Spell Lore Ranks</label>
      <input type="number" name="system.grantedSpellLoreRanks" value="{{system.grantedSpellLoreRanks}}" min="0" />
    </div>

    {{#if system.skillBonuses.length}}
    <h3 class="section-subtitle">Skill Bonuses</h3>
    <div class="item-array-list">
      {{#each system.skillBonuses}}
      <div class="array-row">
        <span class="array-label">{{this.skillName}}</span>
        <span class="array-value">+{{this.bonus}}</span>
      </div>
      {{/each}}
    </div>
    {{/if}}

    {{#if system.saveRollBonuses.length}}
    <h3 class="section-subtitle">Save Roll Bonuses</h3>
    <div class="item-array-list">
      {{#each system.saveRollBonuses}}
      <div class="array-row">
        <span class="array-label">{{this.against}}</span>
        <span class="array-value">+{{this.bonus}}</span>
      </div>
      {{/each}}
    </div>
    {{/if}}

    {{#if system.defenseBonuses.length}}
    <h3 class="section-subtitle">Defense Bonuses</h3>
    <div class="item-array-list">
      {{#each system.defenseBonuses}}
      <div class="array-row">
        <span class="array-label">{{this.against}}</span>
        <span class="array-value">+{{this.bonus}}</span>
      </div>
      {{/each}}
    </div>
    {{/if}}

    {{#if system.grantsSpellLores.length}}
    <h3 class="section-subtitle">Granted Spell Lores</h3>
    <div class="item-array-list">
      {{#each system.grantsSpellLores}}
      <div class="array-row">
        <span class="array-value">{{this}}</span>
      </div>
      {{/each}}
    </div>
    {{/if}}
    {{/if}}

    {{#if isItemOfPower}}
    <div class="field-row">
      <label class="field-label">Purpose</label>
      <input type="text" name="system.purpose" value="{{system.purpose}}" />
    </div>
    <div class="field-row">
      <label class="field-label">Affinity Score</label>
      <input type="number" name="system.affinityScore" value="{{system.affinityScore}}" min="0" max="10" />
    </div>
    <div class="field-row field-row--checkbox">
      <input type="checkbox" name="system.attunementStatus" {{#if system.attunementStatus}}checked{{/if}} />
      <label>Attuned</label>
    </div>
    <div class="field-row">
      <label class="field-label">Attunement Requirements</label>
      <input type="text" name="system.attunementRequirements" value="{{system.attunementRequirements}}" />
    </div>
    <div class="field-row field-row--checkbox">
      <input type="checkbox" name="system.isTainted" {{#if system.isTainted}}checked{{/if}} />
      <label>Tainted</label>
    </div>
    <div class="field-row field-row--checkbox">
      <input type="checkbox" name="system.isCursed" {{#if system.isCursed}}checked{{/if}} />
      <label>Cursed</label>
    </div>
    <div class="field-row">
      <label class="field-label">Curse Description</label>
      <input type="text" name="system.curseDescription" value="{{system.curseDescription}}" />
    </div>
    {{/if}}

    {{#if isBackground}}
    <h3 class="section-subtitle">Minor Tier</h3>
    <div class="field-row">
      <label class="field-label">Cost (BP)</label>
      <input type="number" name="system.minor.cost" value="{{system.minor.cost}}" min="1" max="10" />
    </div>
    <div class="field-row">
      <label class="field-label">Requirement</label>
      {{editor system.minor.requirement target="system.minor.requirement" button=true editable=true class="item-description-sm"}}
    </div>
    <div class="field-row">
      <label class="field-label">Effects</label>
      {{editor system.minor.effects target="system.minor.effects" button=true editable=true class="item-description-sm"}}
    </div>

    <h3 class="section-subtitle">Major Tier</h3>
    <div class="field-row">
      <label class="field-label">Cost (BP)</label>
      <input type="number" name="system.major.cost" value="{{system.major.cost}}" min="1" max="10" />
    </div>
    <div class="field-row">
      <label class="field-label">Requirement</label>
      {{editor system.major.requirement target="system.major.requirement" button=true editable=true class="item-description-sm"}}
    </div>
    <div class="field-row">
      <label class="field-label">Effects</label>
      {{editor system.major.effects target="system.major.effects" button=true editable=true class="item-description-sm"}}
    </div>
    {{/if}}
  </div>
</section>
