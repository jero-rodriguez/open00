<nav class="tabs sheet-tabs" data-group="primary" aria-label="{{localize 'SHEETS.FormNavLabel'}}">
  {{#each tabs}}
  <button type="button" class="item {{cssClass}}" data-action="tab" data-group="{{group}}" data-tab="{{id}}" aria-pressed="{{active}}">
    {{localize label}}
  </button>
  {{/each}}
</nav>
