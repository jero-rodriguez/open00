<section class="tab open00-tab-scroll item-type-{{itemType}} {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <div class="spell-lore-spells">
    {{#if system.spells.length}}
    <div class="spell-lore-item-table item-rules-table table-heading">
      <span>Weave</span><span>Spell</span><span>Range</span><span>AoE</span><span>Duration</span><span>Save</span><span></span>
    </div>
    {{#each system.spells}}
    <details class="spell-details">
      <summary class="spell-lore-item-table item-rules-table item-row">
        <span>{{this.weave}}</span>
        <span>{{this.name}}{{#if this.isInstantaneous}}*{{/if}}</span>
        <span>{{this.range}}</span>
        <span>{{this.areaOfEffect}}</span>
        <span>{{this.duration}}</span>
        <span>{{#if this.grantsSaveRoll}}Y{{else}}N{{/if}}</span>
        <span class="row-actions">
          <button type="button" class="icon-button danger" data-action="removeSpell" data-spell-index="{{@index}}" title="Remove"><i class="fas fa-trash" aria-hidden="true"></i></button>
        </span>
      </summary>
      <div class="spell-description">
        {{#if ../editable}}<prose-mirror name="system.spells.{{@index}}.description" value="{{this.description}}"></prose-mirror>{{else}}<div class="editor"><div class="editor-content">{{{this.enrichedSpellDescription}}}</div></div>{{/if}}
      </div>
    </details>
    {{/each}}
    {{else}}
    <p class="empty-state drop-hint">Drop Spell items here to add them to this lore.</p>
    {{/if}}
  </div>
</section>
