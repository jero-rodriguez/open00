{
  "id": "open00",
  "title": "Open 00",
  "description": "A game system for playing Open 00 in Foundry Virtual Tabletop.",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "url": "https://github.com/jero-rodriguez/open00",
  "manifest": "https://github.com/jero-rodriguez/open00/releases/latest/download/system.json",
  "authors": [
    {
      "name": "Jeronimo Rodriguez",
      "flags": {}
    }
  ],
  "esmodules": [
    "open00-system.mjs"
  ],
  "styles": [
    "styles/open00-system.css"
  ],
  "languages": [
    { "lang": "en", "name": "English", "path": "lang/en.json", "flags": {} },
    { "lang": "es", "name": "Español", "path": "lang/es.json", "flags": {} }
  ],
  "documentTypes": {
    "Actor": {
      "character": { "htmlFields": ["biography", "appearance", "backgroundNotes"] },
      "npc": {}
    },
    "Item": {
      "weapon": { "htmlFields": ["notes", "description"] },
      "armor": { "htmlFields": ["description"] },
      "spell": { "htmlFields": ["description"] },
      "spellLore": { "htmlFields": ["description"] },
      "equipment": { "htmlFields": ["description"] },
      "kin": { "htmlFields": ["description"] },
      "culture": { "htmlFields": ["passionsGuidance", "description"] },
      "vocation": { "htmlFields": ["description"] },
      "trait": { "htmlFields": ["description"] },
      "itemOfPower": { "htmlFields": ["description"] },
      "background": { "htmlFields": ["description", "minor.requirement", "minor.effects", "major.requirement", "major.effects"] }
    }
  },
  "socket": false,
  "initiative": "1d100",
  "grid": {
    "distance": 5,
    "units": "ft"
  },
  "primaryTokenAttribute": "hp",
  "secondaryTokenAttribute": "mp",
  "flags": {}
}
